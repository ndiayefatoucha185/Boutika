# ==============================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT - BOUTIKA SÉNÉGAL
# ==============================================================================

# 1. GOOGLE GEMINI AI (AGENT KIMSI & ANALYSE PHOTO VIP)
# Obligatoire pour l'agent de gouvernance Kimsi et l'analyse de produits VIP.
# Injecté automatiquement par Google AI Studio ou via votre clé d'API.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. URL PUBLIQUE DE L'APPLICATION
APP_URL="MY_APP_URL"
VITE_APP_URL="https://votre-app-boutika.sn"

# 3. BASE DE DONNÉES & AUTHENTIFICATION SUPABASE (POSTGRESQL & RLS)
# A. Variables CLIENT (navigateur React, soumises aux politiques RLS) :
VITE_SUPABASE_URL="https://votre-projet.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="votre_cle_publique_anon_ou_publishable"

# B. Variables SERVEUR (Strictement backend Node.js, AUCUN préfixe VITE_, JAMAIS renvoyées au client) :
# Requise pour persister les démons Kimsi, enregistrer les webhooks marchands et auditer sans blocage RLS
SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="votre_cle_secrete_service_role_backend"

# 4. PASSERELLE DE PAIEMENT WAVE SÉNÉGAL (ENCAISSEMENT AUTOMATISÉ)
# Requis uniquement pour l'activation des webhooks réels et l'API Wave Business.
# Tant que ces variables sont omises, Boutika opère en mode direct WhatsApp & espèces.
WAVE_API_KEY="wave_ci_prod_votre_cle_api_marchand"
WAVE_WEBHOOK_SECRET="wave_whsec_votre_secret_webhook"

# 5. PASSERELLE ORANGE MONEY SÉNÉGAL (OM WEB PAY)
# Requis pour la validation automatisée des paiements Orange Money.
ORANGE_MONEY_MERCHANT_KEY="votre_cle_marchande_om"
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/dev/v1"

# 6. PUBLICATION AUTOMATIQUE 24H SUR RÉSEAUX SOCIAUX (META GRAPH API)
# Requis pour que l'agent publie automatiquement sur Facebook/Instagram sans navigateur ouvert.
META_PAGE_ACCESS_TOKEN="votre_token_de_page_longue_duree"
META_PAGE_ID="votre_identifiant_page_facebook"
